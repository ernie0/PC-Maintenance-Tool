<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 端對端驗證（經伺服器）：同程序起轉送伺服器＋被控端＋控制端，全部走 WebSocket 轉送，
       證實註冊→路由→同意→轉送→解碼整條。存一張解好的畫面。不隨安裝包派送。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMaintenance.Remote.Server\PcMaintenance.Remote.Server.csproj" />
    <ProjectReference Include="..\..\src\PcMaintenance.Remote.Agent\PcMaintenance.Remote.Agent.csproj" />
    <ProjectReference Include="..\..\src\PcMaintenance.Remote.Viewer\PcMaintenance.Remote.Viewer.csproj" />
  </ItemGroup>

</Project>
