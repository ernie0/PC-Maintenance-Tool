<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 配對與隱藏模式驗證：同程序起伺服器＋被控端（配對策略）＋控制端，實測
       第一次要求隱藏但未配對→跳提示並配對；第二次→靜默隱藏不跳提示；偽造憑證拿不到隱藏。
       不隨安裝包派送。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMaintenance.Remote.Server\PcMaintenance.Remote.Server.csproj" />
    <ProjectReference Include="..\..\src\PcMaintenance.Remote.Agent\PcMaintenance.Remote.Agent.csproj" />
    <ProjectReference Include="..\..\src\PcMaintenance.Remote.Viewer\PcMaintenance.Remote.Viewer.csproj" />
  </ItemGroup>

</Project>
