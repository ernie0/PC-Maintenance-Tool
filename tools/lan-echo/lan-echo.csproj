<Project Sdk="Microsoft.NET.Sdk">

  <!-- 跨網路連線測試：純 Core（傳輸＋交握＋加密），不含影像編解碼，方便在缺媒體功能的
       Windows Sandbox 內跑。監聽端送加密框、連線端收下驗章，證實兩台之間連得起來。不隨安裝包派送。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMaintenance.Remote.Core\PcMaintenance.Remote.Core.csproj" />
  </ItemGroup>

</Project>
