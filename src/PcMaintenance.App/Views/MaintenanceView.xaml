<UserControl x:Class="PcMaintenance.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App"
             xmlns:vm="clr-namespace:PcMaintenance.App.ViewModels"
             xmlns:controls="clr-namespace:PcMaintenance.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The ring fills while scanning, then shows how many checks came out fine; its icon swings with every result. -->
        <ContentControl Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="88" Height="88" Margin="0,0,20,0" VerticalAlignment="Center">
                    <controls:RingGauge Thickness="8" TrackBrush="{StaticResource DividerBrush}" local:Motion.Value="{Binding Score}">
                        <controls:RingGauge.Style>
                            <Style TargetType="controls:RingGauge">
                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:RingGauge.Style>
                    </controls:RingGauge>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontSize="24" local:Motion.Kind="Swing" local:Motion.ReplayOn="{Binding Headline}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                    <Setter Property="Text" Value="&#xEC4A;" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                            <Setter Property="Text" Value="&#xE930;" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ScoreText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"
                                   Visibility="{Binding ScoreText, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Headline}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                               local:Motion.Kind="Entrance" local:Motion.ReplayOn="{Binding Headline}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Visibility="{Binding ProgressText, Converter={StaticResource TextToVisibility}}" />
                    <CheckBox Content="處理前先建立系統還原點（會詢問系統管理員權限）" IsChecked="{Binding CreateRestorePoint}" Margin="0,10,0,0"
                              HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="一鍵掃描" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" MinWidth="128"
                            local:Glyph.Text="&#xEC4A;" local:Glyph.Motion="Swing" local:Glyph.Busy="{Binding ScanCommand.IsRunning}" />
                    <Button Content="一鍵修復" Command="{Binding FixCommand}" Style="{StaticResource PrimaryButton}" MinWidth="128" Margin="0,8,0,0"
                            local:Glyph.Text="&#xE90F;" local:Glyph.Motion="Twist" local:Glyph.Busy="{Binding FixCommand.IsRunning}" />
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" MinWidth="128" Margin="0,8,0,0"
                            local:Glyph.Text="&#xE711;" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MaintenanceCheck}">
                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"
                                              Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Grid.Column="1" Style="{StaticResource IconTile}" Width="38" Height="38" Background="{Binding SoftBrush}" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="17" Foreground="{Binding TintBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Top">
                                                <TextBlock x:Name="StateIcon" Style="{StaticResource IconText}" FontSize="14" Visibility="Collapsed"
                                                           local:Motion.Kind="Pop" local:Motion.ReplayOn="{Binding State}" />
                                                <Ellipse x:Name="StateRing" Style="{StaticResource BusyRing}" Width="14" Height="14" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock x:Name="Result" Text="{Binding ResultText}" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource SubtleText}" FontSize="12" Margin="23,2,0,0"
                                                   Visibility="{Binding DetailText, Converter={StaticResource TextToVisibility}}" />
                                    </StackPanel>
                                    <Button x:Name="ActionButton" Grid.Column="3" Content="{Binding ActionText}" Command="{Binding RunActionCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                            local:Glyph.Text="&#xE8A7;" local:Glyph.Motion="Nudge" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Checking">
                                    <Setter TargetName="StateRing" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Fixing">
                                    <Setter TargetName="StateRing" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Good">
                                    <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE73E;" />
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Setter TargetName="Result" Property="Foreground" Value="{StaticResource TextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Found">
                                    <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE946;" />
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Result" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Advice">
                                    <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                    <Setter TargetName="Result" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Fixed">
                                    <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE930;" />
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Setter TargetName="Result" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Partial">
                                    <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                    <Setter TargetName="Result" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding State}" Value="Advice" />
                                        <Condition Binding="{Binding HasAction}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ActionButton" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ContentControl>
    </Grid>
</UserControl>
