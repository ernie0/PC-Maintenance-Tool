<UserControl x:Class="PcMaintenance.App.Views.DiskToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="重新整理" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
                    local:Glyph.Text="&#xE72C;" local:Glyph.Motion="Turn" local:Glyph.Busy="{Binding RefreshCommand.IsRunning}" />
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="{Binding AdminHint}" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap"
                           Visibility="{Binding AdminHint, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="DriveTile" Grid.RowSpan="2" Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="11"
                                        Background="#FFF1E8" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="DriveIcon" Text="&#xEDA2;" Style="{StaticResource IconText}" FontSize="18" Foreground="#C2410C" />
                                </Border>

                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource SubtleText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="12,0,16,0" />
                                </DockPanel>
                                <!-- Health words come from the view model: 正常, 警告, 不良, 未知. -->
                                <Border x:Name="HealthChip" Grid.Column="2" Style="{StaticResource Chip}" Background="{StaticResource DisabledFillBrush}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HealthIcon" Text="&#xE9CE;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                        <TextBlock x:Name="HealthLabel" Text="{Binding HealthText}" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,10,16,0">
                                    <ProgressBar DockPanel.Dock="Left" Width="160" Height="8" Maximum="100" VerticalAlignment="Center"
                                                 local:Motion.Value="{Binding UsedPercent}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding UsageText}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="檢查錯誤" Style="{StaticResource SecondaryButton}" local:Glyph.Text="&#xE9D9;"
                                            Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanCheck, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="最佳化" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" local:Glyph.Text="&#xEC4A;"
                                            Command="{Binding DataContext.OptimizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanOptimize, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="排定開機時修復" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                            local:Glyph.Text="&#xE90F;" local:Glyph.Motion="Twist"
                                            Command="{Binding DataContext.ScheduleRepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanScheduleRepair, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" local:Glyph.Text="&#xE711;"
                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="{Binding ReliabilityText}" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,8,0,0"
                                               Visibility="{Binding ReliabilityText, Converter={StaticResource TextToVisibility}}" />
                                    <DockPanel Margin="0,8,0,0" Visibility="{Binding ResultText, Converter={StaticResource TextToVisibility}}">
                                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                                            <Ellipse Style="{StaticResource BusyRing}"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}"
                                                       local:Motion.Kind="Pop" local:Motion.ReplayOn="{Binding ResultText}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource SubtleText}" FontSize="12" Margin="24,2,0,0"
                                               Visibility="{Binding ResultDetail, Converter={StaticResource TextToVisibility}}" />
                                </StackPanel>
                                <ProgressBar Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" IsIndeterminate="True" Margin="0,10,0,0"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ContentControl>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Volume.IsRemovable}" Value="True">
                                <Setter TargetName="DriveIcon" Property="Text" Value="&#xE88E;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HealthLevel}" Value="正常">
                                <Setter TargetName="HealthChip" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                <Setter TargetName="HealthIcon" Property="Text" Value="&#xE73E;" />
                                <Setter TargetName="HealthIcon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="HealthLabel" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HealthLevel}" Value="警告">
                                <Setter TargetName="HealthChip" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                <Setter TargetName="HealthIcon" Property="Text" Value="&#xE7BA;" />
                                <Setter TargetName="HealthIcon" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                <Setter TargetName="HealthLabel" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                <Setter TargetName="HealthLabel" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HealthLevel}" Value="不良">
                                <Setter TargetName="HealthChip" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                <Setter TargetName="HealthIcon" Property="Text" Value="&#xEA39;" />
                                <Setter TargetName="HealthIcon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter TargetName="HealthLabel" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter TargetName="HealthLabel" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
