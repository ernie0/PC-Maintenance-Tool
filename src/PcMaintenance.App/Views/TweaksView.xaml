<UserControl x:Class="PcMaintenance.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App"
             xmlns:vm="clr-namespace:PcMaintenance.App.ViewModels">
    <UserControl.Resources>
        <!-- The page's own colour (see MainViewModel) for the section icons. -->
        <SolidColorBrush x:Key="PageTintSoft" Color="#ECF2E1" />
        <SolidColorBrush x:Key="PageTintText" Color="#4D7C0F" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningLineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,8,8,8" Margin="0,0,0,10"
                Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="重新啟動檔案總管" Command="{Binding RestartExplorerCommand}" Style="{StaticResource SecondaryButton}"
                        Margin="12,0,0,0" local:Glyph.Text="&#xE72C;" local:Glyph.Motion="Turn" />
                <TextBlock Text="有設定要重新啟動檔案總管後才會生效。" Foreground="{StaticResource WarningTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <!-- Power plan sits at the top of the performance settings. -->
                <ContentControl Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9"
                                Background="{StaticResource PageTintSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="{StaticResource PageTintText}" />
                        </Border>
                        <Button DockPanel.Dock="Right" Content="加入「終極效能」" Command="{Binding AddUltimateCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" local:Glyph.Text="&#xE710;"
                                Visibility="{Binding CanAddUltimate, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Windows 隱藏的電源計畫，效能最高但較耗電，適合桌上型電腦" />
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name"
                                  Width="200" AutomationProperties.Name="電源計畫" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="電源計畫" FontWeight="SemiBold" />
                            <TextBlock Text="「高效能」與「終極效能」讓處理器維持高速，筆電會比較耗電" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ContentControl>

                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TweakSection}">
                            <ContentControl Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="18,14,18,6">
                                        <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="8" Background="{StaticResource PageTintSoft}"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="15" Foreground="{StaticResource PageTintText}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TweakRow}">
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsOn}"
                                                                  IsEnabled="{Binding CanChange}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                                  AutomationProperties.Name="{Binding Name}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding CanChange}" Value="False">
                                                        <Setter TargetName="Note" Property="Foreground" Value="{StaticResource BadgeTextBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
