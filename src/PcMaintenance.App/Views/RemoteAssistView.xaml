<UserControl x:Class="PcMaintenance.App.Views.RemoteAssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 連線控制 -->
        <ContentControl Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <!-- 經伺服器 -->
                <TextBlock Text="經伺服器（NAS）連線" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="伺服器網址" VerticalAlignment="Center" Style="{StaticResource SubtleText}" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" MinWidth="220"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="查詢線上電腦" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshAgentsCommand}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="3" Text="管理者" VerticalAlignment="Center" Style="{StaticResource SubtleText}" Margin="16,0,8,0" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="線上電腦" VerticalAlignment="Center" Style="{StaticResource SubtleText}" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}"
                              DisplayMemberPath="ComputerName" MinWidth="220" VerticalContentAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding AdminName, UpdateSourceTrigger=PropertyChanged}" Width="120"
                             VerticalContentAlignment="Center" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="連線" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectServerCommand}" Margin="8,0,0,0" />
                </Grid>

                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,12" />

                <!-- 直連 -->
                <TextBlock Text="區網直連（不經伺服器）" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="被控端位址" VerticalAlignment="Center" Style="{StaticResource SubtleText}" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding DirectHost, UpdateSourceTrigger=PropertyChanged}" MinWidth="200"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="port" VerticalAlignment="Center" Style="{StaticResource SubtleText}" Margin="12,0,8,0" />
                    <TextBox Grid.Column="3" Text="{Binding DirectPort, UpdateSourceTrigger=PropertyChanged}" Width="72"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="4" Content="直連" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ConnectDirectCommand}" Margin="8,0,0,0" />
                </Grid>

                <!-- 狀態列 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding VerificationCode, Converter={StaticResource TextToVisibility}}" Margin="12,0,0,0">
                        <TextBlock Text="驗證碼 " Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VerificationCode}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                              DisplayMemberPath="Name" MinWidth="160" Margin="12,0,0,0"
                              Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    <Button Grid.Column="3" Content="中斷" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                            Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </ContentControl>

        <!-- 遠端畫面 -->
        <Border Grid.Row="1" Background="Black" CornerRadius="10" ClipToBounds="True">
            <Image x:Name="Screen" Stretch="Uniform" SnapsToDevicePixels="True" Focusable="True" />
        </Border>
    </Grid>
</UserControl>
