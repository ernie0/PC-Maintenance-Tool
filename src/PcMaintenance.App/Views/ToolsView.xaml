<UserControl x:Class="PcMaintenance.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App"
             xmlns:vm="clr-namespace:PcMaintenance.App.ViewModels">
    <UserControl.Resources>
        <!-- The page's own colour (see MainViewModel) for the icon tiles. -->
        <SolidColorBrush x:Key="PageTintSoft" Color="#E9ECF1" />
        <SolidColorBrush x:Key="PageTintText" Color="#475569" />

        <!-- One repair: what it does, its result after running, and a button that turns into a ring while it works. -->
        <DataTemplate x:Key="ToolRow" DataType="{x:Type vm:ToolItem}">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="執行" Command="{Binding RunCommand}" Style="{StaticResource SecondaryButton}" MinWidth="88"
                            Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"
                            local:Glyph.Text="&#xE768;" local:Glyph.Motion="Nudge" local:Glyph.Busy="{Binding RunCommand.IsRunning}" />
                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9"
                            Background="{StaticResource PageTintSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{StaticResource PageTintText}" />
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Chip}" Background="{StaticResource BadgeBrush}" Margin="8,0,0,0"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="需要系統管理員" FontSize="12" Foreground="{StaticResource BadgeTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding ResultText, Converter={StaticResource TextToVisibility}}">
                            <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,1,6,0"
                                       VerticalAlignment="Top" local:Motion.Kind="Pop" local:Motion.ReplayOn="{Binding ResultText}" />
                            <TextBlock Text="{Binding ResultText}" FontSize="13" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ToolCardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="18,14,18,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
            <ContentControl Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="修復" Style="{StaticResource ToolCardTitle}" />
                    <ItemsControl ItemsSource="{Binding Repairs}" ItemTemplate="{StaticResource ToolRow}" Focusable="False" />
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="快速處理" Style="{StaticResource ToolCardTitle}" />
                    <ItemsControl ItemsSource="{Binding QuickFixes}" ItemTemplate="{StaticResource ToolRow}" Focusable="False" />
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="還原點" Style="{StaticResource ToolCardTitle}" />
                    <ItemsControl ItemsSource="{Binding Backups}" ItemTemplate="{StaticResource ToolRow}" Focusable="False" />
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource Card}" Padding="18,14,10,8" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Windows 內建工具" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Launchers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolGroup}">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SubtleText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ToolItem}">
                                                <Button Content="{Binding Title}" Command="{Binding RunCommand}" Style="{StaticResource ToolTile}"
                                                        local:Glyph.Text="{Binding Glyph}" ToolTip="{Binding ResultText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
