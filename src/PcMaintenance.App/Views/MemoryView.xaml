<UserControl x:Class="PcMaintenance.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App"
             xmlns:controls="clr-namespace:PcMaintenance.App.Controls">
    <UserControl.Resources>
        <!-- The page's own colour (see MainViewModel) for its decorations. -->
        <SolidColorBrush x:Key="PageTint" Color="#DB2777" />
        <SolidColorBrush x:Key="PageTintSoft" Color="#FCE7F3" />
        <SolidColorBrush x:Key="PageTintText" Color="#BE185D" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="釋放記憶體" Command="{Binding FreeMemoryCommand}" Style="{StaticResource PrimaryButton}"
                    local:Glyph.Text="&#xE945;" local:Glyph.Motion="Pulse" local:Glyph.Busy="{Binding FreeMemoryCommand.IsRunning}" />
            <Button DockPanel.Dock="Left" Content="重新整理" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    local:Glyph.Text="&#xE72C;" local:Glyph.Motion="Turn" local:Glyph.Busy="{Binding RefreshCommand.IsRunning}" />
            <Button DockPanel.Dock="Right" Content="記憶體檢測…" Command="{Binding ScheduleMemoryTestCommand}" Style="{StaticResource SecondaryButton}"
                    local:Glyph.Text="&#xE9D9;" ToolTip="用 Windows 記憶體診斷檢查記憶體是否故障（需要重新開機）" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Top" Margin="0,1,10,0" local:Motion.Kind="Pop" local:Motion.ReplayOn="{Binding StatusText}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Each card puts its picture beside the label, so the large figure below has the full width. -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
            <ContentControl Style="{StaticResource Card}" Padding="18,14" Margin="0,0,7,0">
                <StackPanel>
                    <DockPanel>
                        <!-- The ring fills to the new figure on every refresh. -->
                        <controls:RingGauge DockPanel.Dock="Right" Width="34" Height="34" Thickness="5"
                                            Stroke="{StaticResource PageTint}" TrackBrush="{StaticResource DividerBrush}"
                                            local:Motion.Value="{Binding UsedPercent}" />
                        <TextBlock Text="記憶體使用量" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding UsedPercentText}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource Card}" Padding="18,14" Margin="7,0,7,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Background="{StaticResource PageTintSoft}">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource IconText}" Foreground="{StaticResource PageTintText}" />
                        </Border>
                        <TextBlock Text="虛擬記憶體" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding CommitText}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CommitDetail}" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource Card}" Padding="18,14" Margin="7,0,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Background="{StaticResource PageTintSoft}">
                            <TextBlock Text="&#xE964;" Style="{StaticResource IconText}" Foreground="{StaticResource PageTintText}" />
                        </Border>
                        <TextBlock Text="已安裝的記憶體" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding InstalledText}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding InstalledDetail}" Style="{StaticResource SubtleText}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
            </ContentControl>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="最占記憶體的程式" Style="{StaticResource SectionTitle}" Margin="16,12,16,10" />
                    <DataGrid ItemsSource="{Binding Programs}" BorderThickness="0,1,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="程式" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="處理程序" Binding="{Binding ProcessesText}" Width="80" ElementStyle="{StaticResource CellTextRight}" />
                            <DataGridTextColumn Header="記憶體" Binding="{Binding MemoryText}" SortMemberPath="MemorySort" Width="92" ElementStyle="{StaticResource CellTextRight}" />
                            <DataGridTextColumn Header="占總量" Binding="{Binding PercentText}" SortMemberPath="Percent" Width="72" ElementStyle="{StaticResource CellTextRight}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding ImageName}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="記憶體模組" Style="{StaticResource SectionTitle}" Margin="16,12,16,10" />
                    <DataGrid ItemsSource="{Binding Modules}" BorderThickness="0,1,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="插槽" Binding="{Binding Slot}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="容量" Binding="{Binding CapacityText}" Width="80" ElementStyle="{StaticResource CellTextRight}" />
                            <DataGridTextColumn Header="規格" Binding="{Binding SpecText}" Width="*" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Maker}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
