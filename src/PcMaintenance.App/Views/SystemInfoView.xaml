<UserControl x:Class="PcMaintenance.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App">
    <UserControl.Resources>
        <DataTemplate x:Key="SectionCard">
            <ContentControl Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <!-- The page's own colour (see MainViewModel). -->
                        <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="8" Background="#E8E7FC" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="15" Foreground="#4338CA" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SubtleText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="複製全部" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}"
                    local:Glyph.Text="&#xE8C8;" />
            <Button DockPanel.Dock="Left" Content="匯出 CSV" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    local:Glyph.Text="&#xEDE1;" local:Glyph.Motion="Nudge" ToolTip="一台電腦一列，方便把各台電腦的檔案合併成一張表" />
            <Button DockPanel.Dock="Right" Content="重新整理" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                    local:Glyph.Text="&#xE72C;" local:Glyph.Motion="Turn" local:Glyph.Busy="{Binding RefreshCommand.IsRunning}" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource SubtleText}" Margin="0,0,0,10"
                   Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding LeftSections}" ItemTemplate="{StaticResource SectionCard}" Focusable="False" VerticalAlignment="Top" />
                <ItemsControl Grid.Column="2" ItemsSource="{Binding RightSections}" ItemTemplate="{StaticResource SectionCard}" Focusable="False"
                              VerticalAlignment="Top" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
