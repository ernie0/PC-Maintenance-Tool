<UserControl x:Class="PcMaintenance.App.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App"
             xmlns:vm="clr-namespace:PcMaintenance.App.ViewModels">
    <UserControl.Resources>
        <!-- Shown in a list area until there is something to list. -->
        <Style x:Key="EmptyHint" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="16" />
        </Style>
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="空間分析" local:Glyph.Text="&#xEB05;" local:Glyph.Motion="Turn">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox ItemsSource="{Binding Drives}" Text="{Binding AnalyzePath, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                              Width="300" AutomationProperties.Name="分析位置" />
                    <Button Content="瀏覽…" Command="{Binding BrowseAnalyzePathCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE838;" />
                    <Button Content="開始分析" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xEB05;" local:Glyph.Motion="Turn" local:Glyph.Busy="{Binding AnalyzeCommand.IsRunning}" />
                    <Button Content="取消" Command="{Binding CancelAnalyzeCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE711;" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding AnalyzeStatus}" Style="{StaticResource SubtleText}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="0,0,0,8"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl Grid.Row="3" ItemsSource="{Binding KindTotals}" Focusable="False" AutomationProperties.Name="檔案類型">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,5" Margin="0,0,8,6" ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SizeText}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource SubtleText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,8,12,8">
                                <Button DockPanel.Dock="Right" Content="在檔案總管中開啟" Command="{Binding ShowFolderCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" Style="{StaticResource SecondaryButton}"
                                        local:Glyph.Text="&#xE838;" />
                                <TextBlock Text="資料夾大小" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <TreeView x:Name="FolderTree" ItemsSource="{Binding RootNodes}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}"
                                          Padding="8,4,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="Padding" Value="2,4" />
                                            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="14" Foreground="#D69E2E" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubtleText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Width="56" Height="6" Margin="10,0,6,0"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PercentText}" Style="{StaticResource SubtleText}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                                <StackPanel Style="{StaticResource EmptyHint}"
                                            Visibility="{Binding HasItems, ElementName=FolderTree, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="&#xEB05;" Style="{StaticResource IconText}" FontSize="28" Foreground="#B4BDC9" />
                                    <TextBlock Text="按「開始分析」後，這裡會列出各資料夾的大小。" Style="{StaticResource SubtleText}" Margin="0,10,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </ContentControl>
                    <ContentControl Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,8,12,8">
                                <Button DockPanel.Dock="Right" Content="在檔案總管中顯示" Command="{Binding ShowLargeFileCommand}"
                                        Style="{StaticResource SecondaryButton}" local:Glyph.Text="&#xE838;" />
                                <TextBlock Text="最大的檔案" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <DataGrid x:Name="LargestGrid" ItemsSource="{Binding LargestFiles}" SelectedItem="{Binding SelectedLargeFile}">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowLargeFileCommand}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="1.7*" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource CellTextRight}" />
                                        <DataGridTextColumn Header="資料夾" Binding="{Binding Folder}" Width="1.3*" ElementStyle="{StaticResource CellText}" />
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="ToolTip" Value="{Binding Path}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                                <StackPanel Style="{StaticResource EmptyHint}" Margin="16,48,16,16"
                                            Visibility="{Binding HasItems, ElementName=LargestGrid, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="28" Foreground="#B4BDC9" />
                                    <TextBlock Text="分析完成後會列出最占空間的檔案。" Style="{StaticResource SubtleText}" Margin="0,10,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </ContentControl>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="重複檔案" local:Glyph.Text="&#xE8C8;">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Wraps so 取消 drops to a second line instead of being cut off in a small window. -->
                <WrapPanel Margin="0,0,0,10">
                    <TextBox Text="{Binding DuplicatePath, UpdateSourceTrigger=PropertyChanged}" Width="280" local:Glyph.Text="&#xE8B7;"
                             AutomationProperties.Name="搜尋位置" />
                    <Button Content="瀏覽…" Command="{Binding BrowseDuplicatePathCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE838;" />
                    <TextBlock Text="最小" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" Width="64" AutomationProperties.Name="最小檔案大小" />
                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Button Content="搜尋重複檔" Command="{Binding FindDuplicatesCommand}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"
                            local:Glyph.Text="&#xE8C8;" local:Glyph.Busy="{Binding FindDuplicatesCommand.IsRunning}" />
                    <Button Content="取消" Command="{Binding CancelDuplicatesCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE711;" Visibility="{Binding IsFindingDuplicates, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Text="{Binding DuplicateStatus}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
                <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="0,0,0,8"
                             Visibility="{Binding IsFindingDuplicates, Converter={StaticResource BoolToVisibility}}" />
                <!-- Groups are listed by hand: DataGrid grouping collapses every column to its minimum width. -->
                <ContentControl Grid.Row="3" Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding DuplicateGroups}" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                            TextElement.Foreground="{StaticResource SubtleTextBrush}" TextElement.FontWeight="SemiBold" TextElement.FontSize="13">
                                        <Grid Margin="0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="116" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="移除" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="檔名" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="資料夾" Margin="10,0" />
                                            <TextBlock Grid.Column="3" Text="修改時間" Margin="10,0" />
                                            <TextBlock Grid.Column="4" Text="大小" Margin="10,0" HorizontalAlignment="Right" />
                                            <!-- Keeps the headers above their columns while the scroll bar is showing. -->
                                            <FrameworkElement Grid.Column="6" Width="{StaticResource ScrollBarSize}"
                                                              Visibility="{Binding ComputedVerticalScrollBarVisibility, ElementName=Scroll}" />
                                        </Grid>
                                    </Border>
                                    <Grid>
                                        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="True" Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                        <StackPanel x:Name="Empty" Style="{StaticResource EmptyHint}" Visibility="Collapsed">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="28" Foreground="#B4BDC9" />
                                            <TextBlock Text="搜尋結果會顯示在這裡。" Style="{StaticResource SubtleText}" Margin="0,10,0,0" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DuplicateGroupRow}">
                                <StackPanel>
                                    <Border Background="{StaticResource SurfaceAltBrush}" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DuplicateFileRow}">
                                                <Border MinHeight="40" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" ToolTip="{Binding File.Path}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="116" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CellText}" Margin="10,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Folder}" Style="{StaticResource CellText}" Margin="10,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource CellText}" Margin="10,0" />
                                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource CellTextRight}" Margin="10,0" />
                                                        <Button Grid.Column="5" Content="開啟位置" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="10,0"
                                                                FontSize="13" Margin="8,5" HorizontalAlignment="Left" local:Glyph.Text="&#xE838;"
                                                                Command="{Binding DataContext.ShowDuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ContentControl>
                <DockPanel Grid.Row="4" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Content="每組保留最新的，其餘勾選" Command="{Binding SelectAllButNewestCommand}" Style="{StaticResource SecondaryButton}"
                            local:Glyph.Text="&#xE762;" />
                    <Button DockPanel.Dock="Right" Content="移到資源回收筒" Command="{Binding RecycleDuplicatesCommand}" Style="{StaticResource DangerButton}"
                            local:Glyph.Text="&#xE74D;" local:Glyph.Busy="{Binding RecycleDuplicatesCommand.IsRunning}" />
                    <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="16,0" Style="{StaticResource SubtleText}" />
                </DockPanel>
            </Grid>
        </TabItem>

        <TabItem Header="空資料夾" local:Glyph.Text="&#xE8B7;" local:Glyph.Motion="Bounce">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                    <TextBox Text="{Binding EmptyFolderPath, UpdateSourceTrigger=PropertyChanged}" Width="320" local:Glyph.Text="&#xE8B7;"
                             AutomationProperties.Name="空資料夾搜尋位置" />
                    <Button Content="瀏覽…" Command="{Binding BrowseEmptyFolderPathCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE838;" />
                    <Button Content="搜尋空資料夾" Command="{Binding FindEmptyFoldersCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE721;" local:Glyph.Busy="{Binding FindEmptyFoldersCommand.IsRunning}" />
                    <Button Content="取消" Command="{Binding CancelEmptyFoldersCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE711;" Visibility="{Binding IsFindingEmptyFolders, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Text="{Binding EmptyFolderStatus}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
                <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="0,0,0,8"
                             Visibility="{Binding IsFindingEmptyFolders, Converter={StaticResource BoolToVisibility}}" />
                <ContentControl Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <ListBox x:Name="EmptyList" ItemsSource="{Binding EmptyFolders}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="空資料夾清單">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativePath}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                                        Padding="14,6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="#F5F8FC" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EmptyFolderRow}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" AutomationProperties.Name="{Binding RelativePath}" />
                                        <Button DockPanel.Dock="Right" Content="開啟位置" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="10,0"
                                                FontSize="13" Margin="8,0,0,0" local:Glyph.Text="&#xE838;"
                                                Command="{Binding DataContext.ShowEmptyFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubfoldersText}" Style="{StaticResource SubtleText}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="14" Foreground="#D69E2E" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding RelativePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder.Path}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Style="{StaticResource EmptyHint}"
                                    Visibility="{Binding HasItems, ElementName=EmptyList, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="28" Foreground="#B4BDC9" />
                            <TextBlock Text="搜尋結果會顯示在這裡。" Style="{StaticResource SubtleText}" Margin="0,10,0,0" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ContentControl>
                <DockPanel Grid.Row="4" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Content="全部勾選／取消" Command="{Binding SelectAllEmptyFoldersCommand}" Style="{StaticResource SecondaryButton}"
                            local:Glyph.Text="&#xE762;" />
                    <Button DockPanel.Dock="Right" Content="移到資源回收筒" Command="{Binding RecycleEmptyFoldersCommand}" Style="{StaticResource DangerButton}"
                            local:Glyph.Text="&#xE74D;" local:Glyph.Busy="{Binding RecycleEmptyFoldersCommand.IsRunning}"
                            AutomationProperties.Name="空資料夾移到資源回收筒" />
                    <TextBlock Text="{Binding EmptySelectionText}" VerticalAlignment="Center" Margin="16,0" Style="{StaticResource SubtleText}" />
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
