<UserControl x:Class="PcMaintenance.App.Views.TaskManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcMaintenance.App"
             xmlns:controls="clr-namespace:PcMaintenance.App.Controls">
    <UserControl.Resources>
        <!-- Kind values come from the view model: cpu, memory, disk, network, gpu, and download / upload in the network tab. -->
        <Style x:Key="ResourceChart" TargetType="controls:Sparkline">
            <Setter Property="Stroke" Value="#2563EB" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="memory">
                    <Setter Property="Stroke" Value="#8B5CF6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="disk">
                    <Setter Property="Stroke" Value="#16A34A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="network">
                    <Setter Property="Stroke" Value="#D97706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="upload">
                    <Setter Property="Stroke" Value="#D97706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="gpu">
                    <Setter Property="Stroke" Value="#0891B2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="處理程序" local:Glyph.Text="&#xE71D;">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <TextBox DockPanel.Dock="Left" Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="搜尋名稱或處理程序編號" local:Glyph.Text="&#xE721;" AutomationProperties.Name="搜尋處理程序" />
                    <Button DockPanel.Dock="Right" Content="結束工作" Command="{Binding EndProcessCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE711;" local:Glyph.Busy="{Binding EndProcessCommand.IsRunning}" />
                    <Button DockPanel.Dock="Right" Content="開啟檔案位置" Command="{Binding OpenLocationCommand}" Style="{StaticResource SecondaryButton}"
                            local:Glyph.Text="&#xE838;" />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SubtleText}" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" TextWrapping="Wrap" />
                </DockPanel>

                <ContentControl Grid.Row="2" Style="{StaticResource Card}">
                    <DataGrid ItemsSource="{Binding ProcessView}" SelectedItem="{Binding SelectedProcess}" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="處理程序編號" Binding="{Binding Id}" SortMemberPath="Id" Width="120" ElementStyle="{StaticResource CellTextRight}" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="CpuPercent" Width="80" ElementStyle="{StaticResource CellTextRight}" />
                            <DataGridTextColumn Header="記憶體" Binding="{Binding MemoryText}" SortMemberPath="MemoryBytes" Width="110" ElementStyle="{StaticResource CellTextRight}" />
                            <DataGridTextColumn Header="執行緒" Binding="{Binding Threads}" SortMemberPath="Threads" Width="80" ElementStyle="{StaticResource CellTextRight}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </ContentControl>

                <TextBlock Grid.Row="3" Text="{Binding SelectionHint}" Foreground="{StaticResource WarningTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding SelectionHint, Converter={StaticResource TextToVisibility}}" />
            </Grid>
        </TabItem>

        <TabItem Header="效能" local:Glyph.Text="&#xE9D2;" local:Glyph.Motion="Grow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="效能項目">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
                                                Padding="10,8" Margin="0,0,4,4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Sparkline Height="40" Values="{Binding History}" Maximum="{Binding Maximum}" Capacity="{Binding Capacity}"
                                                    GridBrush="{StaticResource LineBrush}" Style="{StaticResource ResourceChart}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" DataContext="{Binding SelectedResource}">
                    <!-- Chart and figures share the height, so a small window still shows both. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="*" MinHeight="90" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtleText}" FontSize="15" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,0,2" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,14,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScaleText}" Style="{StaticResource SubtleText}" FontSize="12" />
                            <TextBlock Text="最近 2 分鐘" Style="{StaticResource SubtleText}" FontSize="12" />
                        </DockPanel>
                        <controls:Sparkline Grid.Row="2" Values="{Binding History}" Maximum="{Binding Maximum}"
                                            Capacity="{Binding Capacity}" GridBrush="{StaticResource DividerBrush}" Style="{StaticResource ResourceChart}" />
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="150" Margin="0,8,12,0">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SubtleText}" FontSize="12" />
                                            <TextBlock Text="{Binding Value}" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>
            </Grid>
        </TabItem>

        <TabItem Header="網路" local:Glyph.Text="&#xE968;">
            <Grid DataContext="{Binding Network}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Label"
                             Style="{StaticResource SegmentList}" ItemContainerStyle="{StaticResource SegmentItem}" AutomationProperties.Name="網路檢視" />
                    <Button DockPanel.Dock="Right" Content="匯出清單" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xEDE1;" local:Glyph.Motion="Nudge" ToolTip="把目前檢視的完整清單（含本機內部連線）匯出成 CSV（可用 Excel 開啟）"
                            Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVisibility}}" />
                    <Button DockPanel.Dock="Right" Content="查詢主機名稱" Command="{Binding LookupHostNamesCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE774;" local:Glyph.Busy="{Binding LookupHostNamesCommand.IsRunning}"
                            ToolTip="向這台電腦設定的 DNS 伺服器查詢畫面上各位址的名稱；不按就不會查詢"
                            Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVisibility}}" />
                    <Button DockPanel.Dock="Right" Content="開啟檔案位置" Command="{Binding OpenLocationCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            local:Glyph.Text="&#xE838;" Visibility="{Binding CanShowLocation, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                    <TextBox DockPanel.Dock="Left" Width="230" Margin="0,0,16,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding SearchHint}" local:Glyph.Text="&#xE721;" AutomationProperties.Name="搜尋網路" />
                    <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label"
                             Style="{StaticResource SegmentList}" ItemContainerStyle="{StaticResource SegmentItem}" AutomationProperties.Name="篩選連線"
                             Visibility="{Binding IsConnections, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="{Binding HiddenToggleText}" IsChecked="{Binding ShowInternalAndClosed}" Margin="16,0,0,0" VerticalAlignment="Top"
                              Visibility="{Binding IsConnections, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource SubtleText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NoteText}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" ToolTip="{Binding NoteText}" Visibility="{Binding NoteText, Converter={StaticResource TextToVisibility}}" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   ToolTip="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </DockPanel>

                <ContentControl Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <DataGrid ItemsSource="{Binding ConnectionView}" SelectedItem="{Binding SelectedConnection}" EnableRowVirtualization="True"
                                  AutomationProperties.Name="網路連線" Visibility="{Binding IsConnections, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="程式" Binding="{Binding ProgramName}" Width="1.1*" ElementStyle="{StaticResource CellText}" />
                                <!-- The host name, once looked up, sits under the address. -->
                                <DataGridTemplateColumn Header="位址" Width="1.5*" SortMemberPath="AddressText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AddressText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AddressText}" />
                                                <TextBlock Text="{Binding HostName}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding HostName}" Visibility="{Binding HostName, Converter={StaticResource TextToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="服務" Binding="{Binding ServiceText}" Width="136" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="範圍" Binding="{Binding ScopeText}" Width="92" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="狀態" Binding="{Binding StateText}" Width="80" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                        <!-- Program traffic: the speed of everything (or of the chosen program) over two minutes, then every program. -->
                        <Grid DataContext="{Binding Traffic}" Visibility="{Binding DataContext.IsTraffic, RelativeSource={RelativeSource AncestorType=ContentControl}, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,12,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="3" Text="{Binding ChartTitle, StringFormat=最近 2 分鐘：{0}}" Style="{StaticResource SubtleText}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <StackPanel Grid.Row="1" DataContext="{Binding Download}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScaleText}" Style="{StaticResource SubtleText}" FontSize="12" />
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <controls:Sparkline Height="56" Margin="0,4,0,0" Values="{Binding History}" Maximum="{Binding Maximum}" Capacity="{Binding Capacity}"
                                                        GridBrush="{StaticResource DividerBrush}" Style="{StaticResource ResourceChart}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" DataContext="{Binding Upload}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScaleText}" Style="{StaticResource SubtleText}" FontSize="12" />
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <controls:Sparkline Height="56" Margin="0,4,0,0" Values="{Binding History}" Maximum="{Binding Maximum}" Capacity="{Binding Capacity}"
                                                        GridBrush="{StaticResource DividerBrush}" Style="{StaticResource ResourceChart}" />
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ProgramView}" SelectedItem="{Binding SelectedProgram}" EnableRowVirtualization="True"
                                      AutomationProperties.Name="程式流量">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="程式" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="下載速度" Binding="{Binding DownloadRateText}" SortMemberPath="DownloadRate" Width="120" ElementStyle="{StaticResource CellTextRight}" />
                                    <DataGridTextColumn Header="上傳速度" Binding="{Binding UploadRateText}" SortMemberPath="UploadRate" Width="120" ElementStyle="{StaticResource CellTextRight}" />
                                    <DataGridTextColumn Header="已下載" Binding="{Binding DownloadedText}" SortMemberPath="Downloaded" Width="96" ElementStyle="{StaticResource CellTextRight}" />
                                    <DataGridTextColumn Header="已上傳" Binding="{Binding UploadedText}" SortMemberPath="Uploaded" Width="96" ElementStyle="{StaticResource CellTextRight}" />
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Grid>
                        <DataGrid ItemsSource="{Binding DeviceView}" EnableRowVirtualization="True" AutomationProperties.Name="區域網路裝置"
                                  Visibility="{Binding IsDevices, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP 位址" Binding="{Binding AddressText}" SortMemberPath="SortKey" Width="130" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="主機名稱" Binding="{Binding HostName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="實體位址" Binding="{Binding Mac}" Width="172" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="網路卡" Binding="{Binding AdapterName}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="說明" Binding="{Binding RoleText}" Width="*" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ContentControl>

                <StackPanel Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding IsConnections, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DetailText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailTooltip}"
                               Visibility="{Binding DetailText, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding WarningText, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
