<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 轉送伺服器：放 NAS 的 Linux 容器，所以用純 net10.0（不是 net10.0-windows）。
       只轉送端對端加密的框，看不到畫面內容；保留連線稽核（SQLite）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PcMaintenance.Remote.Server</RootNamespace>
    <AssemblyName>PcMaintenance.Remote.Server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcMaintenance.Remote.Core\PcMaintenance.Remote.Core.csproj" />
  </ItemGroup>

</Project>
