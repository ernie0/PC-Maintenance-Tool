// 電腦維護工具：公司共用設定範例（內容與程式預設值相同）。
// 使用方式：在同一個資料夾複製成 settings.json 再修改；或安裝時加 /SETTINGS="設定檔路徑"。
// 可以寫 // 註解，最後一項後面多一個逗號也沒關係。格式錯誤時程式會改用預設值並在上方顯示提醒。
{
  // 暫存檔與錯誤報告至少要放幾小時才會被清理，避免刪到正在安裝的程式還在用的檔案。
  "minFileAgeHours": 24,

  // 不讓使用者清理的項目代碼，例如 ["recycle-bin"] 表示不提供清空資源回收筒。
  // user-temp 使用者暫存檔            windows-temp Windows 暫存檔
  // edge-cache Microsoft Edge 快取    chrome-cache Google Chrome 快取     firefox-cache Firefox 快取
  // crash-dumps 程式當機傾印檔        user-error-reports 錯誤報告（使用者） system-error-reports 錯誤報告（系統）
  // shader-cache 顯示卡著色器快取     system-crash-dumps 系統當機傾印檔
  // thumbnail-cache 縮圖快取          recent-items 最近使用的項目
  // windows-update-cache Windows 更新下載快取                            delivery-optimization 傳遞最佳化快取
  // windows-old 舊版 Windows（Windows.old，只在有這個資料夾的電腦出現）    recycle-bin 資源回收筒
  "disabledJunkCategories": [],

  // 永遠不刪除的資料夾（也包含重複檔移除），路徑中的 \ 要寫成 \\，例如 "D:\\公司資料"。
  "excludedPaths": [],

  // 「開機與背景」是否列出 Microsoft 的項目。預設隱藏，避免誤停用系統元件。
  "showMicrosoftItems": false,

  // 是否允許變更服務的啟動類型（變更時仍需要系統管理員權限）。
  "allowServiceChanges": true,

  // 搜尋重複檔時預設的最小檔案大小（MB）。
  "duplicateMinSizeMB": 1,

  // 自動清理（安裝時勾選「自動清理」才會啟用）：同一位使用者兩次自動清理至少間隔幾天，0 表示每次登入都清理。
  // 自動清理只處理預設勾選、不需要系統管理員權限的項目，程式正在執行的瀏覽器快取會略過。
  "autoCleanIntervalDays": 7,

  // 「工作管理員 → 網路」要標示為可疑的 IP 位址清單檔，空白表示不使用。一行一個位址或範圍（例如 203.0.113.0/24），# 後面是註解。
  // 可以寫完整路徑（例如 "\\\\伺服器\\共用\\可疑IP.txt"），或只寫檔名，表示放在這個設定檔所在的資料夾（C:\ProgramData\PcMaintenance）。
  "suspiciousAddressList": "",

  // 「軟體解除安裝 → 軟體更新」是否開放：用 Windows 的套件管理員（winget）查詢並更新已安裝的軟體（查詢時會連到 winget 的軟體來源）。
  // 由公司統一派送、管理軟體版本的電腦，可以設成 false 關閉。
  "allowSoftwareUpdates": true,

  // 公司的電腦盤點資料夾，例如 "\\\\伺服器\\共用\\電腦盤點"（每位使用者都要能寫入）。空白表示不使用。
  // 安裝時勾選「定期匯出」的電腦，每位使用者登入時會把電腦配備、軟體清單與瀏覽器擴充功能存到這裡；
  // 「多台電腦」頁也預設讀取這個資料夾（使用者自己選過其他資料夾後，改用使用者的選擇）。
  "inventoryFolder": "",

  // 定期匯出的最短間隔天數（同一位使用者）；1 表示每天第一次登入時匯出，0 表示每次登入都匯出。
  "inventoryIntervalDays": 1
}
